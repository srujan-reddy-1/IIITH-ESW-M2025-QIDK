<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Bot Message Layout (Left Side) -->
    <LinearLayout
        android:id="@+id/left_chat_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="60dp"
        android:orientation="horizontal"
        android:gravity="start"
        android:maxWidth="320dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0">

        <!-- Bot Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bot_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/primary_blue">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_atom"
                app:tint="@color/white" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Bot Message Bubble -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:maxWidth="280dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/bot_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:padding="16dp"
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary"
                android:lineSpacingExtra="2dp"
                android:fontFamily="sans-serif"
                android:textIsSelectable="true"
                android:breakStrategy="simple"
                tools:text="Hi! I'm Atom, your AI tutor. How can I help you today?" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- User Message Layout (Right Side) -->
    <LinearLayout
        android:id="@+id/right_chat_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:orientation="horizontal"
        android:gravity="end"
        android:maxWidth="320dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="1.0">

        <!-- User Message Bubble -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:maxWidth="280dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/user_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:padding="16dp"
                android:textSize="15sp"
                android:textColor="?attr/colorOnPrimary"
                android:lineSpacingExtra="2dp"
                android:fontFamily="sans-serif"
                android:breakStrategy="simple"
                tools:text="What is machine learning?" />

        </com.google.android.material.card.MaterialCardView>

        <!-- User Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/user_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSecondary">

            <ImageView
                android:id="@+id/user_avatar_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                app:tint="?attr/colorOnSecondary" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Message Timestamp (Optional) -->
    <TextView
        android:id="@+id/message_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorTertiary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/left_chat_layout"
        app:layout_constraintStart_toStartOf="@id/left_chat_layout"
        app:layout_constraintEnd_toEndOf="@id/right_chat_layout"
        tools:text="10:30 AM"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
