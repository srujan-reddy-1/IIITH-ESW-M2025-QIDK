<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:backgroundTint="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Question Number and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/question_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Question 1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/answer_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Correct"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/rounded_corner_8dp"
                android:backgroundTint="@color/success_color"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- Question Text -->
        <TextView
            android:id="@+id/review_question_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the time complexity of binary search?"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Your Answer -->
        <LinearLayout
            android:id="@+id/your_answer_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner_8dp"
            android:backgroundTint="@color/error_light"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Answer:"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/your_answer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O(n)"
                android:textSize="14sp"
                android:textColor="@color/error_color" />

        </LinearLayout>

        <!-- Correct Answer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner_8dp"
            android:backgroundTint="@color/success_light"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correct Answer:"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/correct_answer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O(log n)"
                android:textSize="14sp"
                android:textColor="@color/success_color" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
